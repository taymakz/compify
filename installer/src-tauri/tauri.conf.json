{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Compify Setup",
  "identifier": "com.taymaz.compify.setup",
  "version": "1.0.0",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1422",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Compify Setup",
        "width": 480,
        "height": 580,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/icon.ico"
    ]
  }
}
